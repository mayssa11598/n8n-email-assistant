      "parameters": {
        "inputText": "={{ $json.text }}",
        "categories": {
          "categories": [
            {
              "category": "Urgent",
              "description": "Emails that require immediate or very prompt attention. This includes urgent problems, deadlines, critical requests, emergencies, service interruptions, or messages where a delayed response could cause a significant problem."
            },
            {
              "category": "Customer Support",
              "description": "Emails from customers or potential customers asking questions, requesting information, reporting a problem, requesting help, or asking about a product or service."
            },
            {
              "category": "Meeting",
              "description": "Emails related to scheduling, rescheduling, canceling, or confirming meetings, calls, appointments, interviews, or other events."
            },
            {
              "category": "Finance",
              "description": "Emails related to invoices, receipts, payments, billing, refunds, expenses, transaction confirmations, or other financial documents and requests."
            },
            {
              "category": "Informational",
              "description": "Emails that provide information, updates, announcements, reports, or notifications and do not require a significant action or immediate response."
            },
            {
              "category": "Promotional & Marketing",
              "description": "Marketing emails, newsletters, advertisements, promotional offers, product announcements, discounts, campaigns, or sales content."
            }
          ]
        },
        "options": {
          "systemPromptTemplate": "Please classify the text provided by the user into one of the following categories: {categories}, and use the provided formatting instructions below. Don't explain, and only output the json.\nClassify the email into exactly one category.\n\nIf an email could belong to multiple categories, choose the category that best represents the primary purpose of the email.\n\nIMPORTANT:\nIf the email clearly requires immediate attention, contains an urgent request, critical problem, emergency, or important deadline, classify it as \"Urgent / Immediate Attention Needed\" even if it also belongs to another category."
        }
